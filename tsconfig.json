{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "es2023.array"],
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    // "paths": {
    //     "*": ["typings/*"]
    // },
    "esModuleInterop": true,
    "outDir": "lib",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "tests/src/**/*",
    "tests/utils/**/*",
    "tools/**/*",
    "docs/.vitepress/**/*",
    "tsdown.config.ts"
    // "typings/**/*"
  ],
  "exclude": ["lib/**/*"]
}
